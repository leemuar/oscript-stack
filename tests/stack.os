		.ВыбрасываетИсключение("stack underflow")
		;

	ОсвободитьОбъект(Стек);
КонецПроцедуры

Функция ДолженИметьМетодПустой() Экспорт
	Перем Стек, Рефлектор;

	Стек = Новый Стек;
	Рефлектор = Новый Рефлектор;
	Ожидаем
		.Что(Рефлектор.МетодСуществует(Стек, "Пустой"), "Объект стека должен иметь метод Пустой()")
		.ЭтоИстина()
		;

	ОсвободитьОбъект(Стек);
	ОсвободитьОбъект(Рефлектор);
КонецФункции

Функция МетодПустойВозвращаетТоЖеЧтоИEmpty() Экспорт
	Перем Стек;

	Стек = Новый Стек;
	Ожидаем
		.Что(Стек.Пустой(), "Пустой() должен возвращать то же значение, что и empty()")
		.Равно(Истина)
		;

	Стек.push(1);
	Ожидаем
		.Что(Стек.Пустой())
		.Равно(Ложь)
		;

	ОсвободитьОбъект(Стек);
КонецФункции

Функция ДолженИметьМетодСодержит() Экспорт
	Перем Стек, Рефлектор;

	Стек = Новый Стек;
	Рефлектор = Новый Рефлектор;
	Ожидаем
		.Что(Рефлектор.МетодСуществует(Стек, "Содержит"), "Объект стека должен иметь метод Содержит()")
		.ЭтоИстина()
		;

	ОсвободитьОбъект(Стек);
	ОсвободитьОбъект(Рефлектор);
КонецФункции

Функция МетодСодержитВозвращаетТоЖеЧтоИContains() Экспорт
	Перем Стек;

	Стек = Новый Стек;
	Стек.push(1);
	Стек.push(2);
	Ожидаем
		.Что(Стек.Содержит(2), "Содержит() должен возвращать то же значение, что и contains()")
		.Равно(Истина)
		;
	Ожидаем
		.Что(Стек.Содержит(35))
		.Равно(Ложь)
		;

	ОсвободитьОбъект(Стек);
КонецФункции

Функция ДолженИметьМетодОчистить() Экспорт
	Перем Стек, Рефлектор;

	Стек = Новый Стек;
	Рефлектор = Новый Рефлектор;
	Ожидаем
		.Что(Рефлектор.МетодСуществует(Стек, "Очистить"), "Объект стека должен иметь метод Очистить()")
		.ЭтоИстина()
		;

	ОсвободитьОбъект(Стек);
	ОсвободитьОбъект(Рефлектор);
КонецФункции

Функция МетодОчиститьОпустошаетСтек() Экспорт
	Перем Стек;

	Стек = Новый Стек;
	Стек.push(1);
	Стек.push(2);
	Стек.Очистить();
	Ожидаем
		.Что(Стек.count(), "Очистить() должен опустошать стек так же, как clear()")
		.Равно(0)
		;

	ОсвободитьОбъект(Стек);
КонецФункции

Функция АнглоязычныйИРусскоязычныйФасадыРаботаютСОднимиИТемиЖеДанными() Экспорт
	Перем Стек;

	// добавляем через русскоязычный фасад, читаем через англоязычный, и наоборот -
	// оба фасада должны работать с одним и тем же внутренним хранилищем
	Стек = Новый Стек;
	Стек.Добавить(1);
	Стек.push(2);
	Ожидаем
		.Что(Стек.Количество())
		.Равно(2)
		;
	Ожидаем
		.Что(Стек.pop())
		.Равно(2)
		;
	Ожидаем
		.Что(Стек.Извлечь())
		.Равно(1)
		;
	Ожидаем
		.Что(Стек.Пустой())
		.Равно(Истина)
		;

	ОсвободитьОбъект(Стек);
КонецФункции

Процедура Инициализация()
	ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "stack.os"), "Стек");
КонецПроцедуры



Инициализация();